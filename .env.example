# Copy this file to .env. Never commit a DashScope API key.

# Data and runtime state
ICML_PAPERS_DATA_DIR=data
ICML_PAPERS_INDEX_ROOT=.data/index
ICML_PAPERS_STATE_DB_PATH=.data/state/runtime.sqlite3
ICML_PAPERS_SQLITE_BUSY_TIMEOUT_MS=5000

# Milvus 2.5 Standalone
ICML_PAPERS_MILVUS_URI=http://127.0.0.1:19530
ICML_PAPERS_MILVUS_COLLECTION_PREFIX=icml2026_mcp
ICML_PAPERS_MILVUS_TIMEOUT_SECONDS=10

# DashScope embedding, Beijing region
ICML_PAPERS_DASHSCOPE_API_KEY=
# ICML_PAPERS_DASHSCOPE_API_KEY_FILE=/run/secrets/dashscope_api_key
ICML_PAPERS_DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ICML_PAPERS_EMBEDDING_MODEL=qwen3.7-text-embedding
ICML_PAPERS_EMBEDDING_DIM=1024
ICML_PAPERS_EMBEDDING_BATCH_SIZE=20
ICML_PAPERS_EMBEDDING_MAX_ATTEMPTS=3
ICML_PAPERS_EMBEDDING_DEADLINE_SECONDS=12

# Search and sessions
ICML_PAPERS_DEFAULT_TOP_K=10
ICML_PAPERS_MAX_TOP_K=50
ICML_PAPERS_DEPTH_MULTIPLIER=4
ICML_PAPERS_MAX_SEARCH_DEPTH=200
ICML_PAPERS_MAX_QUERY_CHARS=4000
ICML_PAPERS_MAX_GET_PAPER_IDS=50
ICML_PAPERS_SESSION_IDLE_TTL_SECONDS=86400
ICML_PAPERS_MAX_SESSIONS=4096
ICML_PAPERS_MAX_SESSION_ROUNDS=200
ICML_PAPERS_MAX_SESSION_SEEN=6341

# Capacity and provider limits
ICML_PAPERS_PROVIDER_CONCURRENCY=64
ICML_PAPERS_MILVUS_CONCURRENCY=32
ICML_PAPERS_SEARCH_QUEUE_SIZE=512
ICML_PAPERS_QUEUE_TIMEOUT_SECONDS=10
ICML_PAPERS_APP_CPUS=2.0
ICML_PAPERS_BUILD_CPUS=2.0
ICML_PAPERS_IP_RATE_PER_MINUTE=600
ICML_PAPERS_IP_RATE_BURST=100
ICML_PAPERS_IP_SEARCHES_PER_DAY=50000
ICML_PAPERS_IP_SESSION_OPEN_RATE_PER_MINUTE=60
ICML_PAPERS_IP_SESSION_OPEN_BURST=20
ICML_PAPERS_IP_SESSION_OPENS_PER_DAY=5000
ICML_PAPERS_GLOBAL_RATE_PER_MINUTE=6000
ICML_PAPERS_PROVIDER_REQUESTS_PER_MINUTE=24000
ICML_PAPERS_PROVIDER_TOKENS_PER_MINUTE=1000000
ICML_PAPERS_EMBEDDING_CACHE_MAX_ENTRIES=100000
ICML_PAPERS_EMBEDDING_CACHE_TTL_SECONDS=86400

# MCP server
ICML_PAPERS_SERVER_HOST=127.0.0.1
ICML_PAPERS_SERVER_PORT=20441
ICML_PAPERS_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]
ICML_PAPERS_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]
ICML_PAPERS_TRUSTED_PROXY_ENABLED=false
ICML_PAPERS_TRUSTED_PROXY_HEADER=X-ICML-Client-IP
ICML_PAPERS_TRUSTED_PROXY_NETWORKS=[]
