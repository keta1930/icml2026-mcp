# Copy this file to .env and override values as needed; see src/icml_paper_search/config.py.
# Never commit a real DashScope key. Use either a direct key or a key file; the file wins.

# --- Data and local persistence ---
ICML_PAPERS_DATA_DIR=data
ICML_PAPERS_INDEX_ROOT=.data/index
ICML_PAPERS_STATE_DB_PATH=.data/state/runtime.sqlite3
ICML_PAPERS_SQLITE_BUSY_TIMEOUT_MS=5000

# --- DashScope embedding (Beijing region) ---
ICML_PAPERS_DASHSCOPE_API_KEY=
# Containers and servers should use a read-only secret file:
# ICML_PAPERS_DASHSCOPE_API_KEY_FILE=/run/secrets/dashscope_api_key
ICML_PAPERS_DASHSCOPE_HTTP_BASE_URL=https://dashscope.aliyuncs.com/api/v1
ICML_PAPERS_EMBEDDING_MODEL=qwen3.7-text-embedding
ICML_PAPERS_EMBEDDING_DIM=1024
ICML_PAPERS_EMBEDDING_BATCH_SIZE=20
ICML_PAPERS_EMBEDDING_MAX_ATTEMPTS=3
ICML_PAPERS_EMBEDDING_DEADLINE_SECONDS=12

# --- Chroma dense and SQLite FTS5 BM25 fusion ---
ICML_PAPERS_DENSE_WEIGHT=0.8
ICML_PAPERS_BM25_WEIGHT=0.2
ICML_PAPERS_RRF_K=60

# --- Search input and fixed window ---
ICML_PAPERS_DEFAULT_TOP_K=10
ICML_PAPERS_MAX_TOP_K=50
ICML_PAPERS_DEPTH_MULTIPLIER=4
ICML_PAPERS_MAX_SEARCH_DEPTH=200
ICML_PAPERS_MAX_QUERY_CHARS=2000
ICML_PAPERS_MAX_GET_PAPER_IDS=50

# --- Persistent sessions ---
ICML_PAPERS_SESSION_IDLE_TTL_SECONDS=86400
ICML_PAPERS_MAX_SESSIONS=256
ICML_PAPERS_EXHAUSTED_AFTER_EMPTY_ROUNDS=3
ICML_PAPERS_MAX_SESSION_ROUNDS=200
ICML_PAPERS_MAX_SESSION_SEEN=6341
ICML_PAPERS_MAX_SESSION_AUDIT_RECORDS=200
ICML_PAPERS_SESSION_SUMMARY_PAPER_LIMIT=500
ICML_PAPERS_SESSION_LABEL_MAX_CHARS=120

# --- Single-process concurrency and bounded queueing ---
ICML_PAPERS_PROVIDER_CONCURRENCY=4
ICML_PAPERS_CHROMA_CONCURRENCY=2
ICML_PAPERS_SEARCH_QUEUE_SIZE=64
ICML_PAPERS_QUEUE_TIMEOUT_SECONDS=10

# --- Public anonymous service limits and cost budgets ---
ICML_PAPERS_IP_RATE_PER_MINUTE=6
ICML_PAPERS_IP_RATE_BURST=3
ICML_PAPERS_IP_SEARCHES_PER_DAY=200
ICML_PAPERS_IP_SESSION_OPEN_RATE_PER_MINUTE=3
ICML_PAPERS_IP_SESSION_OPEN_BURST=2
ICML_PAPERS_IP_SESSION_OPENS_PER_DAY=20
ICML_PAPERS_GLOBAL_RATE_PER_MINUTE=120
ICML_PAPERS_DAILY_TOKEN_BUDGET=500000
ICML_PAPERS_MONTHLY_TOKEN_BUDGET=10000000
ICML_PAPERS_EMBEDDING_CACHE_MAX_ENTRIES=10000
ICML_PAPERS_EMBEDDING_CACHE_TTL_SECONDS=86400

# --- Output truncation ---
ICML_PAPERS_ABSTRACT_PREVIEW_CHARS=360
ICML_PAPERS_MAX_AUTHORS_SHOWN=4

# --- MCP server (safe local defaults) ---
ICML_PAPERS_SERVER_HOST=127.0.0.1
ICML_PAPERS_SERVER_PORT=20441
ICML_PAPERS_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]
ICML_PAPERS_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*"]

# Enable only when the application accepts traffic exclusively from trusted reverse proxies.
# Public deployments must configure exact Host and Origin values.
ICML_PAPERS_TRUSTED_PROXY_ENABLED=false
ICML_PAPERS_TRUSTED_PROXY_HEADER=X-ICML-Client-IP
ICML_PAPERS_TRUSTED_PROXY_NETWORKS=[]
