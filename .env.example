# 复制为 .env 后按需覆盖；所有配置项见 src/icml_paper_search/config.py
# 未设置的项使用代码内默认值。

# --- 向量库 ---
ICML_PAPERS_MILVUS_URI=http://localhost:20340
# ICML_PAPERS_MILVUS_TOKEN=
ICML_PAPERS_COLLECTION=icml2026repro_papers

# --- Embedding 模型（本地路径或 HF repo id）---
ICML_PAPERS_EMBEDDING_MODEL_PATH=/home/yyx/projects/infra/model/jina-embeddings-v5-text-small
ICML_PAPERS_EMBEDDING_DEVICE=cuda
ICML_PAPERS_EMBEDDING_DTYPE=bfloat16

# --- 混合排序权重 ---
ICML_PAPERS_DENSE_WEIGHT=0.8
ICML_PAPERS_BM25_WEIGHT=0.2

# --- 检索规模 ---
ICML_PAPERS_DEFAULT_TOP_K=10
ICML_PAPERS_MAX_TOP_K=50
# 检索窗口 = top_k × DEPTH_MULTIPLIER；调大 = 同一 query 能挖更深、但更晚出现零新增信号
ICML_PAPERS_DEPTH_MULTIPLIER=4
ICML_PAPERS_MAX_SEARCH_DEPTH=200

# --- 会话 ---
ICML_PAPERS_MAX_SESSIONS=32
ICML_PAPERS_SESSION_IDLE_TTL_SECONDS=86400
ICML_PAPERS_EXHAUSTED_AFTER_EMPTY_ROUNDS=3

# --- 输出裁剪 ---
ICML_PAPERS_ABSTRACT_PREVIEW_CHARS=360
ICML_PAPERS_MAX_AUTHORS_SHOWN=4

# --- MCP server（streamable HTTP transport）---
# 本机监听；client 连 http://127.0.0.1:SERVER_PORT/mcp
ICML_PAPERS_SERVER_HOST=127.0.0.1
ICML_PAPERS_SERVER_PORT=20441
