{
  "name": "icml-paper-search-docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 20440",
    "generate:reference": "uv --project .. run python scripts/generate_reference.py",
    "check:reference": "uv --project .. run python scripts/generate_reference.py --check",
    "check:docs": "uv --project .. run python scripts/check_docs.py",
    "build": "pnpm generate:reference && pnpm check:docs && next build && node scripts/export_markdown.mjs",
    "start": "uv --project .. run python -m http.server 20440 --bind 127.0.0.1 --directory out",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.28.2",
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@orama/tokenizers": "^3.1.18",
    "beautiful-mermaid": "1.1.3",
    "fumadocs-core": "16.13.0",
    "fumadocs-mdx": "15.2.0",
    "fumadocs-ui": "16.13.0",
    "next": "16.2.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  }
}
